# Copy this file to .env and fill in real values.
# .env is gitignored — never commit your key.

# --- Groq suggestion assistant ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq rotates its hosted models; if the default 404s, start the API
# and GET http://127.0.0.1:8001/api/chat/models to list ids your key can use.
# GROQ_MODEL=qwen/qwen3.8-27b

# --- YOLO weights ---
# Path to your trained poster detector checkpoint.
# Defaults to models/weights/best.pt when unset.
# MODEL_WEIGHTS=C:\path\to\best.pt
